# Server & Client Configuration
PORT=45450
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (SQLite — file is auto-created, no server needed)
DATABASE_URL="file:./dev.db"

# JWT Secrets (generate your own: openssl rand -hex 32)
JWT_ACCESS_SECRET=dummy_jwt_access_secret_replace_me_with_64_hex_chars
JWT_REFRESH_SECRET=dummy_jwt_refresh_secret_replace_me_with_64_hex_chars

# Token Encryption (AES-256-GCM key — 64 hex characters / 32 bytes)
TOKEN_ENCRYPTION_KEY=dummy_token_encryption_key_replace_me_64hex
VAULT_MASTER_SECRET=dummy_vault_master_secret_replace_me_64hex

# Google OAuth (dummy values — create an OAuth client in Google Cloud Console)
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_REDIRECT_URI=http://localhost:45450/api/connected-accounts/google/callback
